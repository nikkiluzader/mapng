{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mapng",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-28",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "mapng.com",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "dev-mapng",
      "routes": [
        {
          "pattern": "dev.mapng.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "OSM_TILES",
          "bucket_name": "mapng-osm"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "HOTSPOTS",
            "class_name": "ExportHotspots"
          }
        ]
      },
      "send_email": [
        {
          "name": "CRASH_MAIL"
        }
      ],
      "vars": {
        "CRASH_MAIL_FROM": "reports@mapng.com",
        "ACCESS_TEAM_DOMAIN": "mapng.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "CF_ZONE_ID": "7aa5952a2427445baca40d6bacdd1c8a"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "OSM_TILES",
      "bucket_name": "mapng-osm"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOTSPOTS",
        "class_name": "ExportHotspots"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExportHotspots"
      ]
    }
  ],
  "send_email": [
    {
      "name": "CRASH_MAIL"
    }
  ],
  "vars": {
    "CRASH_MAIL_FROM": "reports@mapng.com",
    "ACCESS_TEAM_DOMAIN": "mapng.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "CF_ZONE_ID": "7aa5952a2427445baca40d6bacdd1c8a"
  }
}
