{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mapng",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-28",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/asset-review.html",
      "/asset-review"
    ]
  },
  "routes": [
    {
      "pattern": "mapng.com",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "dev-mapng",
      "routes": [
        {
          "pattern": "dev.mapng.com",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "OSM_TILES",
          "bucket_name": "mapng-osm"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "HOTSPOTS",
            "class_name": "ExportHotspots"
          }
        ]
      },
      "send_email": [
        {
          "name": "CRASH_MAIL"
        }
      ],
      "vars": {
        "CRASH_MAIL_FROM": "reports@mapng.com",
        "ACCESS_TEAM_DOMAIN": "mapng.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "CF_ZONE_ID": "7aa5952a2427445baca40d6bacdd1c8a",
        "ASSET_PAGE": "1"
      },
      "ratelimits": [
        {
          "name": "RL_WRITE",
          "namespace_id": "2001",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_READ",
          "namespace_id": "2002",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "RL_TILES",
          "namespace_id": "2003",
          "simple": {
            "limit": 3000,
            "period": 60
          }
        },
        {
          "name": "RL_NOMINATIM",
          "namespace_id": "2004",
          "simple": {
            "limit": 50,
            "period": 60
          }
        }
      ]
    }
  },
  "r2_buckets": [
    {
      "binding": "OSM_TILES",
      "bucket_name": "mapng-osm"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOTSPOTS",
        "class_name": "ExportHotspots"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExportHotspots"
      ]
    }
  ],
  "send_email": [
    {
      "name": "CRASH_MAIL"
    }
  ],
  "vars": {
    "CRASH_MAIL_FROM": "reports@mapng.com",
    "ACCESS_TEAM_DOMAIN": "mapng.cloudflareaccess.com",
    "ACCESS_AUD": "5359051fcf74668b7e46d70d09334891e51ef49aa403309b4d0a7f5e738708ea",
    "CF_ZONE_ID": "7aa5952a2427445baca40d6bacdd1c8a"
  },
  "ratelimits": [
    {
      "name": "RL_WRITE",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RL_READ",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_TILES",
      "namespace_id": "1003",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    },
    {
      "name": "RL_NOMINATIM",
      "namespace_id": "1004",
      "simple": {
        "limit": 50,
        "period": 60
      }
    }
  ]
}
